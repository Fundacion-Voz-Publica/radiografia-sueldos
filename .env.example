# Copia este archivo a .env.local (desarrollo) o cárgalo como variables de entorno en Vercel (producción).

# URL pública del sitio. En local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Entra ID / Azure AD (Azure Portal > Microsoft Entra ID > App registrations) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Quién puede entrar ---
# Dominios de correo permitidos, separados por coma (sin @). Ej:
# ALLOWED_EMAIL_DOMAINS=fundacionvozpublica.cl,fundacionvozpublica.onmicrosoft.com
ALLOWED_EMAIL_DOMAINS=

# Correos sueltos permitidos aunque no calcen con los dominios de arriba (opcional)
ALLOWED_EMAILS=

# Poner en "true" SOLO para probar en local sin configurar dominios todavía (deja pasar a cualquiera). Nunca en producción.
ALLOW_ALL=false
